{
  "routes": [
    {
      "route": "/.specify/*",
      "statusCode": 404
    },
    {
      "route": "/.claude/*",
      "statusCode": 404
    },
    {
      "route": "/.idea/*",
      "statusCode": 404
    },
    {
      "route": "/docs/*",
      "statusCode": 404
    },
    {
      "route": "/CLAUDE.md",
      "statusCode": 404
    },
    {
      "route": "/microbot/fonts/*",
      "headers": {
        "cache-control": "public, max-age=604800",
        "access-control-allow-origin": "*"
      }
    },
    {
      "route": "/images/*",
      "headers": {
        "cache-control": "public, max-age=604800"
      }
    },
    {
      "route": "/microbot/*.{png,jpg,jpeg,gif,svg,ico,woff,woff2,ttf,eot}",
      "headers": {
        "cache-control": "public, max-age=604800"
      }
    },
    {
      "route": "/microbot/*.{css,js}",
      "headers": {
        "cache-control": "public, max-age=3600"
      }
    },
    {
      "route": "/libraries/*",
      "headers": {
        "cache-control": "public, max-age=3600"
      }
    }
  ]
}
