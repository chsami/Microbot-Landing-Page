{
  "routes": [
    {
      "route": "/images/*",
      "headers": {
        "cache-control": "public, max-age=604800"
      }
    },
    {
      "route": "/microbot/*.{png,jpg,jpeg,gif,svg,ico,woff,woff2,ttf,eot}",
      "headers": {
        "cache-control": "public, max-age=604800"
      }
    },
    {
      "route": "/microbot/*.{css,js}",
      "headers": {
        "cache-control": "public, max-age=3600"
      }
    },
    {
      "route": "/libraries/*",
      "headers": {
        "cache-control": "public, max-age=3600"
      }
    }
  ]
}
